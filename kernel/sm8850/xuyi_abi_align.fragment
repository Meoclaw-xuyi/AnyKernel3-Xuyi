# A17 ABI 对齐 fragment：将本树配置强制对齐 Kokuban 发布内核（官方 OGKI 对齐）
# 依据：kokuban Mi17_Kernel ReSuki 20261005-1516 发布包内嵌 .config
# 与我们构建的差异项（boot 失败根因：配置差异 -> 符号 CRC 漂移 -> 厂商模块拒载）

CONFIG_BBG=y
# CONFIG_BBG_BLOCK_BOOT is not set
# CONFIG_BBG_BLOCK_RECOVERY is not set
# CONFIG_DEFAULT_BRUTAL is not set
# CONFIG_IP6_NF_TARGET_NPT is not set
CONFIG_MODULE_SCMVERSION=y
CONFIG_MQ_IOSCHED_DEFAULT_ADIOS=y
# CONFIG_NETFILTER_NETLINK_HOOK is not set
CONFIG_NET_SCH_FQ_PIE=y
CONFIG_NFT_COMPAT=y
# CONFIG_NFT_CONNLIMIT is not set
CONFIG_NFT_CT=y
# CONFIG_NFT_DUP_IPV4 is not set
# CONFIG_NFT_DUP_IPV6 is not set
# CONFIG_NFT_FIB_IPV4 is not set
# CONFIG_NFT_FIB_IPV6 is not set
# CONFIG_NFT_HASH is not set
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
# CONFIG_NFT_NUMGEN is not set
# CONFIG_NFT_OSF is not set
# CONFIG_NFT_QUEUE is not set
# CONFIG_NFT_QUOTA is not set
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y
# CONFIG_NFT_SOCKET is not set
# CONFIG_NFT_SYNPROXY is not set
# CONFIG_NFT_TPROXY is not set
# CONFIG_NFT_TUNNEL is not set
# CONFIG_NFT_XFRM is not set
# CONFIG_NF_FLOW_TABLE is not set
# CONFIG_NF_TABLES_ARP is not set
# CONFIG_NF_TABLES_BRIDGE is not set
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
# CONFIG_NF_TABLES_NETDEV is not set
# CONFIG_NTFS3_64BIT_CLUSTER is not set
# CONFIG_NTFS3_FS_POSIX_ACL is not set
# CONFIG_NTFS3_LZX_XPRESS is not set
CONFIG_REKERNEL_NETWORK=y
# CONFIG_SQUASHFS_4K_DEVBLK_SIZE is not set
# CONFIG_SQUASHFS_CHOICE_DECOMP_BY_MOUNT is not set
# CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI is not set
# CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU is not set
CONFIG_SQUASHFS_COMPILE_DECOMP_SINGLE=y
CONFIG_SQUASHFS_DECOMP_SINGLE=y
# CONFIG_SQUASHFS_EMBEDDED is not set
CONFIG_SQUASHFS_FILE_CACHE=y
# CONFIG_SQUASHFS_FILE_DIRECT is not set
CONFIG_SQUASHFS_FRAGMENT_CACHE_SIZE=3
# CONFIG_SQUASHFS_LZ4 is not set
# CONFIG_SQUASHFS_LZO is not set
# CONFIG_SQUASHFS_XATTR is not set
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_ZSTD=y
# CONFIG_DMABUF_HEAPS_CMA is not set
# CONFIG_DMABUF_HEAPS_SYSTEM is not set
# CONFIG_HEADERS_INSTALL is not set
# CONFIG_IP_NF_TARGET_TTL is not set
# CONFIG_KSM is not set
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,ipe,bpf"
CONFIG_MQ_IOSCHED_ADIOS=m
# CONFIG_NETFILTER_XT_TARGET_HL is not set
# CONFIG_NET_SCH_CAKE is not set
# CONFIG_NET_SCH_PIE is not set
# CONFIG_NF_TABLES is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_PID_NS is not set
# CONFIG_REKERNEL is not set
# CONFIG_SQUASHFS is not set
# CONFIG_TCP_CONG_BRUTAL is not set
# CONFIG_USER_NS is not set
# (cosmetic, 不对齐) CONFIG_LOCALVERSION 保持本树默认: "-4k"
# (cosmetic, 不对齐) CONFIG_KSU_FULL_NAME_FORMAT 保持本树默认: "%TAG_NAME%-%COMMIT_SHA%"
# (cosmetic, 不对齐) CONFIG_PAHOLE_VERSION 保持本树默认: 132
